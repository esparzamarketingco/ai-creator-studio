# ---- Core ----
# PostgreSQL connection string
DATABASE_URL="postgresql://studio:studio@localhost:5432/ai_creator_studio_dev"
# Public base URL of the app (used for links in emails and signed URLs)
APP_URL="http://localhost:3000"
# 64 hex chars (32 bytes). Encrypts integration credentials and TOTP secrets at rest.
# Generate: openssl rand -hex 32
APP_ENCRYPTION_KEY=""
# 64 hex chars. Signs expiring private-media URLs. Generate: openssl rand -hex 32
MEDIA_SIGNING_KEY=""
# Allow new account registration (set to "false" after creating your account)
ALLOW_REGISTRATION="true"

# ---- Private media storage ----
# "local" stores files in STORAGE_DIR (outside /public). "s3" uses any S3-compatible bucket.
STORAGE_DRIVER="local"
STORAGE_DIR="./.storage"
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ENDPOINT=""          # e.g. https://<account>.r2.cloudflarestorage.com for Cloudflare R2
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"

# ---- Email (password reset / verification). Empty = links are written to the server log ----
SMTP_URL=""
EMAIL_FROM="AI Creator Studio <no-reply@example.com>"

# ---- Mock providers (development only; outputs are labeled SIMULATED) ----
ENABLE_MOCK_PROVIDERS="true"

# ---- Background worker ----
WORKER_POLL_MS="5000"
