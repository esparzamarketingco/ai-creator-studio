// AI Creator Studio — database schema.
// Approval integrity is anchored on AssetVersion.sha256: an ApprovalRecord stores
// the exact hash it approved, and publishing re-hashes the stored file before use.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum WorkspaceKind {
  LIFESTYLE // Workspace A: sensual, fitness, fashion, lifestyle
  ADULT // Workspace B: restricted adult workspace
}

enum WorkspaceRole {
  MANAGER // can approve and publish
  CONTRIBUTOR // can plan, prompt, upload
  REVIEWER // read-only + comments
}

enum ContentStatus {
  IDEA
  PROMPT_READY
  GENERATING
  PROCESSING
  AWAITING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHED
  REJECTED
  NEEDS_REVISIONS
  GENERATION_FAILED
  PUBLICATION_FAILED
  ARCHIVED
}

enum AssetKind {
  VIDEO
  IMAGE
  THUMBNAIL
}

enum AssetSource {
  UPLOAD
  GENERATED
  SIMULATED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  REVISIONS_REQUESTED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum IntegrationKind {
  VIDEO_GENERATION
  IMAGE_GENERATION
  STORAGE
  PUBLISHING
  ANALYTICS
  NOTIFICATIONS
}

enum IntegrationStatus {
  DISCONNECTED
  CONFIGURED
  AWAITING_AUTHORIZATION
  UNAVAILABLE
  OPERATIONAL
}

enum ScheduleStatus {
  QUEUED // approved + waiting for its publish time
  PUBLISHING
  AWAITING_MANUAL // manual destination: package ready, waiting for creator to post + confirm
  PUBLISHED // destination confirmed
  FAILED // retries exhausted or permanent failure
  CANCELED
}

enum AttemptOutcome {
  BLOCKED
  SUCCEEDED
  FAILED
}

enum ConfirmationSource {
  DESTINATION_API
  CREATOR_MANUAL_CONFIRMATION
  SIMULATED_DESTINATION
}

enum LikenessRelationship {
  SELF
  AUTHORIZED_OTHER
}

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  name                  String
  passwordHash          String
  role                  UserRole  @default(EDITOR)
  emailVerifiedAt       DateTime?
  totpSecretEnc         String?
  totpEnabled           Boolean   @default(false)
  adultAccessAttestedAt DateTime? // user attested they are 18+ and authorized for Workspace B
  failedLoginCount      Int       @default(0)
  lockedUntil           DateTime?
  securityNotifications Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  sessions           Session[]
  resetTokens        PasswordResetToken[]
  verificationTokens EmailVerificationToken[]
  memberships        WorkspaceMember[]
  creatorProfile     CreatorProfile?
  approvals          ApprovalRecord[]
  notifications      Notification[]
  auditLogs          AuditLog[]
}

model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mfaPending Boolean   @default(false)
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model RateLimitBucket {
  key         String   @id
  count       Int
  windowStart DateTime
}

model Workspace {
  id              String        @id @default(cuid())
  slug            String        @unique
  name            String
  kind            WorkspaceKind
  description     String        @default("")
  disclosureText  String        @default("")
  defaultTimezone String        @default("America/New_York")
  // Content categories and intensity levels configurable per workspace.
  categories      String[]      @default([])
  intensityLevels String[]      @default([])
  exportSettings  Json          @default("{}")
  createdAt       DateTime      @default(now())

  members      WorkspaceMember[]
  concepts     ContentConcept[]
  assets       MediaAsset[]
  schedules    PublishingSchedule[]
  integrations PlatformIntegration[]
  snapshots    AnalyticsSnapshot[]
  experiments  Experiment[]
  ideas        IdeaBacklogItem[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        WorkspaceRole @default(CONTRIBUTOR)
  createdAt   DateTime      @default(now())

  @@unique([workspaceId, userId])
}

model CreatorProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName           String   @default("")
  username              String   @default("")
  bio                   String   @default("")
  brandVoice            String   @default("")
  visualIdentity        String   @default("")
  appearance            Json     @default("{}") // hairstyle, facial hair, skin tone, distinctive features
  physique              String   @default("")
  preferredEnvironments String[] @default([])
  preferredStyles       String[] @default([])
  preferredLighting     String[] @default([])
  preferredFraming      String[] @default([])
  disclosureText        String   @default("This content was created with AI assistance. Depicted scenes are synthetic.")
  profilePhotoKey       String?
  bannerKey             String?
  updatedAt             DateTime @updatedAt

  likenessRefs LikenessReference[]
  characters   CharacterProfile[]
}

model LikenessReference {
  id                 String               @id @default(cuid())
  creatorProfileId   String
  creatorProfile     CreatorProfile       @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  label              String
  subjectName        String
  relationship       LikenessRelationship @default(SELF)
  storageKey         String
  sha256             String
  mimeType           String
  sizeBytes          Int
  consentStatement   String
  consentConfirmedAt DateTime
  revokedAt          DateTime?
  createdAt          DateTime             @default(now())

  characters CharacterProfile[]
}

model CharacterProfile {
  id               String             @id @default(cuid())
  creatorProfileId String
  creatorProfile   CreatorProfile     @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  name             String
  description      String             @default("")
  apparentAge      Int // must be >= 21; enforced server-side
  adultConfirmed   Boolean            @default(false)
  isFictional      Boolean            @default(true)
  likenessRefId    String? // when set, uses an authorized facial reference
  likenessRef      LikenessReference? @relation(fields: [likenessRefId], references: [id])
  physique         String             @default("")
  styleNotes       String             @default("")
  continuityRules  String             @default("")
  archivedAt       DateTime?
  createdAt        DateTime           @default(now())

  concepts ContentConcept[]
}

model ContentConcept {
  id              String            @id @default(cuid())
  workspaceId     String
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title           String
  description     String            @default("")
  audience        String            @default("Adults 18+ (U.S.)")
  category        String            @default("")
  intensityLevel  String            @default("")
  characterId     String?
  character       CharacterProfile? @relation(fields: [characterId], references: [id])
  scene           String            @default("")
  location        String            @default("")
  wardrobe        String            @default("")
  lighting        String            @default("")
  camera          String            @default("")
  visualStyle     String            @default("")
  durationSec     Int               @default(15)
  aspectRatio     String            @default("9:16")
  resolution      String            @default("1080x1920")
  continuityRules String            @default("")
  caption         String            @default("")
  hashtags        String[]          @default([])
  callToAction    String            @default("")
  tags            String[]          @default([])
  status          ContentStatus     @default(IDEA)
  plannedDate     String? // YYYY-MM-DD in the slot's timezone
  plannedTime     String? // HH:mm
  timezone        String            @default("America/New_York")
  createdById     String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  prompts   GenerationPrompt[]
  jobs      GenerationJob[]
  assets    MediaAsset[]
  schedules PublishingSchedule[]

  @@index([workspaceId, plannedDate])
  @@index([workspaceId, status])
}

model GenerationPrompt {
  id             String         @id @default(cuid())
  conceptId      String
  concept        ContentConcept @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  version        Int
  providerKey    String
  positivePrompt String
  negativePrompt String         @default("")
  params         Json           @default("{}")
  createdAt      DateTime       @default(now())

  jobs GenerationJob[]

  @@unique([conceptId, version])
}

model GenerationJob {
  id             String           @id @default(cuid())
  conceptId      String
  concept        ContentConcept   @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  promptId       String
  prompt         GenerationPrompt @relation(fields: [promptId], references: [id])
  providerKey    String
  kind           AssetKind        @default(VIDEO)
  status         JobStatus        @default(QUEUED)
  isSimulated    Boolean          @default(false)
  externalJobId  String?
  idempotencyKey String           @unique
  attempts       Int              @default(0)
  maxAttempts    Int              @default(3)
  lastError      String?
  resultAssetId  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([conceptId])
}

model MediaAsset {
  id               String          @id @default(cuid())
  workspaceId      String
  workspace        Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conceptId        String?
  concept          ContentConcept? @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  kind             AssetKind
  title            String
  tags             String[]        @default([])
  category         String          @default("")
  currentVersionId String?         @unique
  currentVersion   AssetVersion?   @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  archivedAt       DateTime?
  deletedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  versions  AssetVersion[]       @relation("AssetVersions")
  schedules PublishingSchedule[]

  @@index([workspaceId, kind])
}

model AssetVersion {
  id              String      @id @default(cuid())
  assetId         String
  asset           MediaAsset  @relation("AssetVersions", fields: [assetId], references: [id], onDelete: Cascade)
  currentOf       MediaAsset? @relation("CurrentVersion")
  versionNumber   Int
  storageKey      String
  sha256          String
  sizeBytes       Int
  mimeType        String
  durationSec     Float?
  width           Int?
  height          Int?
  source          AssetSource
  isSimulated     Boolean     @default(false)
  providerKey     String?
  generationJobId String?
  validation      Json        @default("{}")
  createdById     String?
  createdAt       DateTime    @default(now())

  approvals ApprovalRecord[]

  @@unique([assetId, versionNumber])
}

model ApprovalRecord {
  id                String           @id @default(cuid())
  assetVersionId    String
  assetVersion      AssetVersion     @relation(fields: [assetVersionId], references: [id], onDelete: Cascade)
  approvedSha256    String
  decision          ApprovalDecision
  notes             String           @default("")
  decidedById       String
  decidedBy         User             @relation(fields: [decidedById], references: [id])
  decidedAt         DateTime         @default(now())
  invalidatedAt     DateTime?
  invalidatedReason String?

  @@index([assetVersionId])
}

model PlatformIntegration {
  id                      String            @id @default(cuid())
  workspaceId             String?
  workspace               Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind                    IntegrationKind
  providerKey             String
  displayName             String
  status                  IntegrationStatus @default(DISCONNECTED)
  credentialsEnc          String?
  credentialHint          String? // e.g. "••••3f9a" — never the secret
  isSimulated             Boolean           @default(false)
  allowsAdultContent      Boolean           @default(false)
  allowsLikeness          Boolean           @default(false)
  supportsDirectPublish   Boolean           @default(false)
  policyVerifiedAt        DateTime?
  policyNotes             String            @default("")
  lastHealthCheckAt       DateTime?
  lastHealthOk            Boolean?
  firstPublishConfirmedAt DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  schedules PublishingSchedule[]

  @@unique([workspaceId, providerKey])
}

model PublishingSchedule {
  id             String              @id @default(cuid())
  workspaceId    String
  workspace      Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conceptId      String
  concept        ContentConcept      @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  assetId        String
  asset          MediaAsset          @relation(fields: [assetId], references: [id])
  assetVersionId String
  approvalId     String
  integrationId  String
  integration    PlatformIntegration @relation(fields: [integrationId], references: [id])
  scheduledFor   DateTime
  timezone       String
  caption        String              @default("")
  hashtags       String[]            @default([])
  isPromo        Boolean             @default(false)
  status         ScheduleStatus      @default(QUEUED)
  attempts       Int                 @default(0)
  maxAttempts    Int                 @default(3)
  nextAttemptAt  DateTime?
  lastError      String?
  createdById    String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  attempts_log PublishAttempt[]
  post         PublishedPost?

  @@index([status, scheduledFor])
}

model PublishAttempt {
  id             String             @id @default(cuid())
  scheduleId     String
  schedule       PublishingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  assetVersionId String
  outcome        AttemptOutcome
  reasonCode     String
  message        String             @default("")
  actorUserId    String?
  createdAt      DateTime           @default(now())
}

model PublishedPost {
  id                 String             @id @default(cuid())
  scheduleId         String             @unique
  schedule           PublishingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  externalPostId     String?
  externalUrl        String?
  confirmationSource ConfirmationSource
  confirmedAt        DateTime           @default(now())
}

model AnalyticsSnapshot {
  id          String     @id @default(cuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source      String // e.g. "DEMO", "CSV import: earnings-statement.csv", integration key
  isDemo      Boolean    @default(false)
  retrievedAt DateTime   @default(now())
  periodStart DateTime
  periodEnd   DateTime
  // profileVisits, newSubscribers, activeSubscribers, churnedSubscribers, revenueCents,
  // engagements, impressions, clicks, adSpendCents — all optional
  metrics     Json
  postRef     String? // optional: schedule id / caption variant this snapshot is about
  createdAt   DateTime   @default(now())

  @@index([workspaceId, periodStart])
}

model Experiment {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  hypothesis  String
  variable    String // CAPTION | THUMBNAIL | POSTING_TIME
  variantA    String
  variantB    String
  metric      String
  status      String    @default("DRAFT") // DRAFT | RUNNING | CONCLUDED
  resultNotes String    @default("")
  startedAt   DateTime?
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
}

model IdeaBacklogItem {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  notes       String    @default("")
  source      String    @default("MANUAL") // MANUAL | PERFORMANCE
  priority    Int       @default(3)
  createdAt   DateTime  @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String    @default("")
  link      String?
  dedupeKey String?   @unique
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId String?
  action      String
  entityType  String
  entityId    String?
  outcome     String   @default("OK")
  metadata    Json     @default("{}")
  ip          String?
  createdAt   DateTime @default(now())

  @@index([action, createdAt])
  @@index([entityType, entityId])
}

model BackgroundJob {
  id             String    @id @default(cuid())
  type           String
  payload        Json
  status         JobStatus @default(QUEUED)
  runAt          DateTime  @default(now())
  attempts       Int       @default(0)
  maxAttempts    Int       @default(5)
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, runAt])
}

/// Media bytes for STORAGE_DRIVER=database: keeps a free deployment working with only a database.
/// Postgres is not built for large blobs, so move to S3/R2 once the library grows.
model StoredObject {
  key         String   @id
  contentType String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())
}
